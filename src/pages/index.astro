---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-6"
            data-testid="game-search-form"
            role="search"
          >
            <label for="game-search" class="block text-sm font-medium text-slate-200 mb-2">
              Search games by title
            </label>
            <input
              id="game-search"
              type="search"
              placeholder="Search by game title"
              autocomplete="off"
              data-testid="game-search-input"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-4 py-3 text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            />
          </form>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div
            class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700"
            data-testid="search-empty-state"
            hidden
          >
            <p class="text-slate-300">No games match your search.</p>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-search-form"]');
  const input = document.querySelector<HTMLInputElement>('[data-testid="game-search-input"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="search-empty-state"]');

  if (form && input && grid && emptyState) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    const updateResults = (): void => {
      const query = input.value.trim().toLocaleLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.dataset.gameTitle?.toLocaleLowerCase() ?? '';
        const matches = title.includes(query);
        card.hidden = !matches;

        if (matches) {
          visibleCount += 1;
        }
      });

      grid.hidden = visibleCount === 0;
      emptyState.hidden = visibleCount !== 0;
    };

    input.addEventListener('input', updateResults);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      updateResults();
    });
  }
</script>
